# Local dev defaults — persist to local Postgres (backend at :8000) for native-app feel.
# Set VITE_MOCK_API=true only if you want offline MSW mocks (no DB writes).
VITE_API_URL=http://localhost:8000/api
VITE_MOCK_API=false
# Production auth goes through the backend /auth/login endpoint using mobile + password.
# SMS OTP and frontend Supabase env vars are not required for the current pilot.
