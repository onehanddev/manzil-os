# Copy this file to .env and fill in your values.
# Supabase (Auth only — the frontend talks to Supabase directly for login/signup).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Our FastAPI backend. Relative path proxies through Vite in dev.
VITE_API_URL=/api

# When true, the app uses MSW (Mock Service Worker) so the shell,
# society switcher and pages work without a backend. Great for UI work.
VITE_MOCK_API=true
