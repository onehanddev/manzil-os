# Copy to .env and fill in — never commit .env
# === Local dev (default) — `alembic upgrade head` uses this ===
DATABASE_URL="postgresql://hakimuddinhaweliwala@localhost:5432/manzil_os"

# === Test DB — used by pytest (see backend/tests/conftest.py) ===
# TEST_DATABASE_URL="postgresql://hakimuddinhaweliwala@localhost:5432/manzil_os_test"
# or override at runtime:
#   DATABASE_URL="postgresql://.../manzil_os_test" uv run alembic upgrade head

# === Production (Supabase pooler) — set only when deploying ===
# The pooler URL needs ?pgbouncer=true; backend/config.py and backend/alembic/env.py strip it automatically
# DATABASE_URL="postgresql://postgres.xxx:password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Previous project zzxgefmhwnpplvpweymi is paused/deleted (ENOTFOUND) — replace with your active project

# === Supabase Auth — set when using Supabase OTP/WhatsApp (Issue 3) ===
# Frontend uses VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY (frontend/.env)
# Backend verifies Supabase JWTs and creates users via service role.
# When not set, backend falls back to local bcrypt JWT (pytest/offline dev still passes).
SUPABASE_URL="https://xxx.supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIs..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIs..."
SUPABASE_JWT_SECRET="super-secret-jwt-key-with-32-chars!!"
