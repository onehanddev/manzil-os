# EventBridge/App Runner protected jobs
# JOB_SECRET="generate-a-long-random-secret"

# Notification provider toggle – no WhatsApp/OTP required for demo
# test: logs to DB `notifications` + stdout, no external call (default for pilot)
# live: calls Meta WhatsApp Cloud API when all credentials below are set
PROVIDER_MODE="test"
# PROVIDER_MODE="live"

# Meta WhatsApp Cloud API sending (required when PROVIDER_MODE=live)
# From Meta > WhatsApp > API Setup: temporary/permanent access token + Phone number ID.
# WHATSAPP_TOKEN="paste_meta_access_token_here"
# WHATSAPP_PHONE_ID="paste_phone_number_id_here"
# Template must exist in WhatsApp Manager and match the receipt body/button placeholders.
# WHATSAPP_TEMPLATE_NAME="maintenance_receipt"
# WHATSAPP_TEMPLATE_LANG="en_US"
# Receipt delivery: sends to the flat's linked owner/tenant (FlatOccupant) mobile if present
# (payer_person_id if set, otherwise the flat's active occupant — owner preferred).
# If the flat has no linked occupant/mobile, falls back to WHATSAPP_FALLBACK_TO / WHATSAPP_TEST_TO.
# Use country code with no plus, for example: 919876543210
# WHATSAPP_FALLBACK_TO="919876543210"
# WHATSAPP_TEST_TO="919876543210"  # legacy alias for FALLBACK_TO — kept for backwards-compat
# Public HTTPS base for the DOCUMENT header link (required — Meta fetches the PDF).
# Must be the public API origin that serves /receipts/{id}/pdf?token=... e.g. https://api.manzilos.com
# PUBLIC_BASE_URL="https://api.manzilos.com"

# Meta WhatsApp Cloud API webhook verification (paste this same token into Meta portal)
# WHATSAPP_VERIFY_TOKEN="generate-a-long-random-verify-token"
# Optional: Meta App Secret for X-Hub-Signature-256 verification (from Meta App Dashboard > App Settings > Basic)
# WHATSAPP_APP_SECRET="your_meta_app_secret"
